<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target mirrors SurrealForge.Client so the same consumer set
         (netstandard tooling + net10.0 production apps) can reference it. -->
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591 = missing XML doc comments; tolerated while internal. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- Package metadata for the coordinated publish set. -->
  <PropertyGroup>
    <PackageId>SurrealForge.Vector</PackageId>
    <Authors>SurrealForge Contributors</Authors>
    <Company>SurrealForge</Company>
    <Description>Vector search and embedding-pipeline core for SurrealForge: indexed KNN + brute-force search, text chunking, embedding cache, and schema-declared backfill jobs. No ONNX dependency.</Description>
    <RepositoryUrl>https://github.com/Escherbridge/surrealforge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Escherbridge/surrealforge</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>surrealdb;database;vector;embeddings;knn</PackageTags>
    <IsPackable>true</IsPackable>
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SurrealForge.Client/SurrealForge.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <!-- IHostedService for the backfill job runner. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <!-- Bounded channels (backfill backpressure) on netstandard2.0; in-box on net10.0. -->
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

</Project>
